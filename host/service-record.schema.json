{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innygr.github.io/Mission-Link/schemas/host-service-v1.json",
  "title": "MissionLink Host Service Record",
  "description": "Versioned, transport-neutral metadata for a service hosted on a non-radio computer reachable through a MissionLink gateway. Never publish credentials or private endpoint details in mesh announcements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serviceId",
    "hostId",
    "displayName",
    "capabilities",
    "transports",
    "healthy",
    "maxInlineRequestBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "hostId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["lan", "usb-serial", "bluetooth"]
      }
    },
    "endpoint": {
      "type": "string",
      "maxLength": 512,
      "description": "Local registry metadata only. Do not put private endpoints in mesh advertisements. Production remote endpoints must use authenticated TLS."
    },
    "healthy": {
      "type": "boolean"
    },
    "maxInlineRequestBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 96,
      "description": "Conservative inline request ceiling. Bulk files and AI model data must use a separately authenticated direct transport."
    }
  }
}
